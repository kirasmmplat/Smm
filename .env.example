# ═══════════════════════════════════════════════════
# SMM Pro Platform — متغيرات البيئة الكاملة
# انسخ هذا الملف وسمّه .env.local (للتطوير)
# أو أضف المتغيرات مباشرة في Vercel / Railway
# ═══════════════════════════════════════════════════

# ── قاعدة البيانات ─────────────────────────────────
# Railway: انسخ الـ DATABASE_URL من صفحة PostgreSQL
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/smmpro"

# ── NextAuth ────────────────────────────────────────
# رابط موقعك الكامل (بدون / في النهاية)
NEXTAUTH_URL="https://your-domain.vercel.app"
# أنشئ قيمة عشوائية: openssl rand -hex 32
NEXTAUTH_SECRET="replace-with-random-secret-min-32-chars"
SESSION_SECRET="replace-with-another-random-secret-min-32-chars"

# ── الموقع ──────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="SMM Pro"
# اختياري — لـ Google Search Console
GOOGLE_SITE_VERIFICATION=""

# ── Cron Jobs ───────────────────────────────────────
# كلمة سر تأمين الـ Cron (أي نص عشوائي قوي)
# استخدمها عند استدعاء الـ Cron:
# Authorization: Bearer YOUR_CRON_SECRET
CRON_SECRET="replace-with-random-cron-secret"

# ── البريد الإلكتروني (Resend) ──────────────────────
# سجّل مجاناً على resend.com واحصل على API Key
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# البريد الظاهر في الإيميلات المرسلة
EMAIL_FROM="SMM Pro <noreply@yourdomain.com>"

# ── الدفع: Stripe ────────────────────────────────────
# من dashboard.stripe.com ← Developers ← API Keys
STRIPE_SECRET_KEY="your-stripe-secret-key-sk_live_or_sk_test"
# من dashboard.stripe.com ← Developers ← Webhooks
# أضف Endpoint: https://your-domain.vercel.app/api/payments/stripe/webhook
# الـ Events المطلوبة: checkout.session.completed
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Telegram Bot (اختياري) ───────────────────────────
# من @BotFather على تيليجرام — أنشئ بوت واحصل على التوكن
TELEGRAM_BOT_TOKEN="1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
